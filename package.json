{
  "name": "crezia",
  "version": "1.0.0",
  "description": "Crezia personal finance API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node scripts/refuse-in-production.cjs && prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/refuse-in-production.cjs && prisma db seed",
    "postinstall": "prisma generate",
    "test:api": "playwright test",
    "dev:test": "tsx watch --env-file=.env.test src/server.ts",
    "db:test:check": "tsx --env-file=.env.test scripts/test-db-check.ts",
    "db:test:migrate": "npm run db:test:check && node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy",
    "db:test:seed": "npm run db:test:check && tsx --env-file=.env.test prisma/seed.ts",
    "db:test:purge-e2e": "npm run db:test:check && tsx --env-file=.env.test scripts/test-db-purge-e2e.ts",
    "test:api:test": "npm run db:test:check && node --env-file=.env.test node_modules/@playwright/test/cli.js test",
    "test:api:ratelimit": "node scripts/test-api-ratelimit.cjs",
    "test:api:ratelimit:login": "node scripts/test-api-ratelimit-login.cjs",
    "dev:perf": "tsx watch --env-file=.env.perf src/server.ts",
    "db:perf:reset": "tsx --env-file=.env.perf scripts/perf-db-reset.ts",
    "db:perf:seed": "tsx --env-file=.env.perf prisma/seed.perf.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnyiManco848/Crezia.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AnyiManco848/Crezia/issues"
  },
  "homepage": "https://github.com/AnyiManco848/Crezia#readme",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
