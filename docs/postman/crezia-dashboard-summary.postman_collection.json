{
  "info": {
    "name": "Crezia - Resumen del Panel",
    "description": "Peticiones de GET /movements/summary (DASH-001) con sus pruebas. Variables de environment: baseUrl (http://localhost:3000/api), email, password y token (se llena sola con Login). No guardes credenciales reales en este archivo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login responde 200 con token', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('token');",
              "  pm.environment.set('token', body.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      },
      "response": []
    },
    {
      "name": "Resumen del mes actual (200)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Primer y ultimo dia del mes actual, en formato AAAA-MM-DD.",
              "const now = new Date();",
              "const pad = (n) => String(n).padStart(2, '0');",
              "const last = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();",
              "pm.variables.set('from', `${now.getFullYear()}-${pad(now.getMonth() + 1)}-01`);",
              "pm.variables.set('to', `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(last)}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cents = (v) => Math.round(parseFloat(v) * 100);",
              "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Trae la estructura esperada', function () {",
              "  const b = pm.response.json();",
              "  pm.expect(b).to.have.all.keys('from', 'to', 'currencyCode', 'totalIncome', 'totalExpense', 'balance', 'movementCount');",
              "  pm.expect(b.from).to.eql(pm.variables.get('from'));",
              "  pm.expect(b.to).to.eql(pm.variables.get('to'));",
              "  pm.expect(b.currencyCode).to.eql('COP');",
              "  pm.expect(b.movementCount).to.be.a('number');",
              "  ['totalIncome', 'totalExpense', 'balance'].forEach(function (k) {",
              "    pm.expect(b[k]).to.match(/^-?\\d+\\.\\d{2}$/);",
              "  });",
              "});",
              "pm.test('balance = ingresos - egresos', function () {",
              "  const b = pm.response.json();",
              "  pm.expect(cents(b.balance)).to.eql(cents(b.totalIncome) - cents(b.totalExpense));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/movements/summary?from={{from}}&to={{to}}",
          "host": ["{{baseUrl}}"],
          "path": ["movements", "summary"],
          "query": [
            { "key": "from", "value": "{{from}}" },
            { "key": "to", "value": "{{to}}" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Resumen de un mes sin movimientos (200, ceros)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 con ceros', function () {",
              "  pm.response.to.have.status(200);",
              "  const b = pm.response.json();",
              "  pm.expect(b.totalIncome).to.eql('0.00');",
              "  pm.expect(b.totalExpense).to.eql('0.00');",
              "  pm.expect(b.balance).to.eql('0.00');",
              "  pm.expect(b.movementCount).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/movements/summary?from=2001-01-01&to=2001-01-31",
          "host": ["{{baseUrl}}"],
