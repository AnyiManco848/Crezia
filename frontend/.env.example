# Base URL of the Crezia API. Only public values go here: Vite exposes every VITE_* variable to the browser.
# Never put secrets in this file.
#
# Local development (.env): the API of this machine.
# Production (Vercel > Settings > Environment Variables): the PUBLIC https URL of the API (Railway), for example
#   VITE_API_URL=https://crezia-api.up.railway.app
# A production build ("vite build") FAILS if it is missing, is not https or points to localhost, and it is the
# origin the Content-Security-Policy allows (connect-src). Set it BEFORE the build: it is baked into the bundle.
VITE_API_URL=http://localhost:3000

# Only to try a production build on your machine ("npm run build" then "npm run preview") against a local API.
# NEVER set it on Vercel.
# VITE_ALLOW_LOCAL_API=true
