# Backend settings for the TEST database (a second Supabase project, NOT the real one).
# Copy to .env.test and fill it in. .env.test is in .gitignore: never commit it.
# Used only with `--env-file=.env.test` (see README, "Pruebas E2E del front").
# Fill ALL four variables: a missing one would fall back to the real .env.

# Test project, transaction pooler (runtime). Port 6543 + pgbouncer=true
DATABASE_URL="postgresql://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Test project, session pooler (migrations and seed). Port 5432
DIRECT_URL="postgresql://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

JWT_SECRET="test-only-secret-change-me"
JWT_EXPIRES_IN="1d"
PORT=3000

# Mandatory for the backend tests: turns on the guards that refuse a database equal to the real one.
TEST_MODE=true

# Registration rate limit for the test backend: high, so the API tests do not hit it. The rate-limit test
# starts its own backend with a low value (see docs/generated/test-database.md).
REGISTER_RATE_LIMIT_MAX=1000
