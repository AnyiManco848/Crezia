# Local PostgreSQL database used ONLY for performance tests (npm run dev:perf / db:perf:reset).
# Copy to .env.perf and write your password. If it has special characters (@ : / # ?), URL-encode them.
PERF_MODE=true

# Plain local Postgres: no pooler, no pgbouncer. Both URLs point to the same database.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/crezia_perf"
DIRECT_URL="postgresql://postgres:<password>@localhost:5432/crezia_perf"

# Only signs tokens for the perf backend; it does not need to match .env.
JWT_SECRET="perf-only-secret-change-me"
JWT_EXPIRES_IN="1d"
PORT=3000

# Volume seed (prisma/seed.perf.ts). PERF_USER_PASSWORD must match data/users.js in Crezia_Performance.
PERF_USERS=50
PERF_ACCOUNTS_PER_USER=3
PERF_MOVEMENTS_PER_USER=2000
PERF_GOALS_PER_USER=5
PERF_USER_PASSWORD="Perf123*"

# Backend tuning (all optional). Leave DB_POOL_CONNECTION_TIMEOUT_MS unset for no wait limit.
# DB_POOL_MAX=20
# DB_POOL_CONNECTION_TIMEOUT_MS=
# UV_THREADPOOL_SIZE=   # default: number of CPU cores (4..32), so bcrypt logins use all of them
