# Crezia API: environment variables. Copy to .env for local work (.env is in .gitignore: never commit it).
# In production (Railway) these are set in the service's Variables panel, not in a file.
# The README has a table with what goes in production and what must NOT exist there.

# ---------- Database (Supabase) ----------
# Runtime: transaction pooler. Port 6543 + pgbouncer=true
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI (migrate deploy, seed): session pooler. Port 5432. REQUIRED wherever the CLI runs, even to
# "prisma generate" (the Dockerfile uses a dummy value for that step).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------- Auth ----------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In production the server refuses to start with a shorter one or with this placeholder.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# ---------- Server ----------
# Railway sets PORT itself. Locally: 3000.
PORT=3000

# "production" in the deployed service (the Dockerfile already sets it). Turns on the production guard
# (src/config/productionGuard.ts). Leave it unset locally.
# NODE_ENV=production

# Origins (the front end) allowed to call the API from a browser, separated by commas. Scheme + host (+ port),
# no path and no trailing slash. No wildcards. When unset: http://localhost:5173 and http://127.0.0.1:5173
# (the Vite dev server). REQUIRED in production, without localhost. Example:
# CORS_ORIGINS="https://crezia.vercel.app"

# Number of proxies in front of the API (empty/false = none, the local default). Needed so the registration
# rate limit sees the real client IP. Examples: 1 (one proxy/load balancer), "loopback, 10.0.0.0/8".
# Never "true". Behind Railway it is usually 1, but CHECK it (README, "Despliegue en Railway").
TRUST_PROXY=

# ---------- Optional tuning ----------
# Database connections per process (default 10) and how long a request may wait for one (no timeout if unset).
# DB_POOL_MAX=10
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# libuv threadpool for bcrypt (default: number of CPUs, between 4 and 32).
# UV_THREADPOOL_SIZE=4

# ---------- Only for the TEST or PERF setups: NEVER in production ----------
# Registration attempts per IP (defaults: 10 every 15 minutes). Raise them only in .env.test.
# REGISTER_RATE_LIMIT_MAX=10
# REGISTER_RATE_LIMIT_WINDOW_MS=900000
# TEST_MODE=true     # see .env.test.example
# PERF_MODE=true     # see .env.perf.example
