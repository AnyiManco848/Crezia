# Keep the image small and, above all, keep secrets out of it.

# Secrets and local configuration: NEVER in an image
.env
.env.*
!.env.example

# Dependencies and build output are produced inside the image
node_modules
dist
coverage
playwright-report
test-results
src/generated

# Not part of the API image
frontend
docs
tests
fixtures
data
services
utils
.claude
.git
.gitignore
*.md
playwright.config.ts
vitest.config.ts
docker-compose.yml
Dockerfile
.dockerignore
